# NAVER API HUB (NAVER Cloud Platform 콘솔) — 2026-07-31부로 검색/데이터랩 API가 여기로 이관됨.
# console.ncloud.com 로그인 → All Services > Application Services > NAVER API HUB
# → Application 생성 시 Search, Search Trend, Shopping Insight 모두 체크 → 인증 정보에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 — Google Cloud Console에서 발급 (무료, 하루 10,000 unit)
YOUTUBE_API_KEY=

# Claude API — 큐레이션(WHY TRENDING/요약/타임라인 생성)용. console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 관리자 API(/api/admin/*) 접근 토큰. 비워 두면 관리자 API가 닫힌다(503).
# 생성 예: openssl rand -hex 32
ADMIN_TOKEN=

# 후보 발견/검증 파이프라인 실행 주기 (cron 표현식, 기본: 4시간마다)
PIPELINE_CRON=0 */4 * * *

# 서버 포트
PORT=8787

# DB 파일 경로 (node:sqlite)
DB_PATH=./data/now-earth.sqlite
